#!/bin/sh
# J/OS HQ: runs an operator-approved action exactly as approved. See jos-hq/gateway/jos-approved.mjs.
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")
case `uname` in
  *CYGWIN*|*MINGW*|*MSYS*)
    if command -v cygpath > /dev/null 2>&1; then
      basedir=`cygpath -w "$basedir"`
    fi
    ;;
esac
exec node "$basedir/../jos-approved.mjs" "$@"
