#!/bin/sh
# J/OS HQ: `one` inside an HQ-dispatched executor resolves here and runs the HQ One gateway.
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")
case `uname` in
  *CYGWIN*|*MINGW*|*MSYS*)
    if command -v cygpath > /dev/null 2>&1; then
      basedir=`cygpath -w "$basedir"`
    fi
    ;;
esac
exec node "$basedir/../one-gateway.mjs" "$@"
